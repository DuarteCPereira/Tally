CREATE TABLE Exercise (
  id TEXT NOT NULL PRIMARY KEY,
  name TEXT NOT NULL,
  defaultSets INTEGER NOT NULL DEFAULT 3,
  defaultReps INTEGER NOT NULL DEFAULT 10,
  defaultRestSeconds INTEGER NOT NULL DEFAULT 60,
  notes TEXT,
  imagePath TEXT
);

CREATE TABLE Workout (
  id TEXT NOT NULL PRIMARY KEY,
  name TEXT NOT NULL,
  position INTEGER NOT NULL,
  createdAt TEXT NOT NULL
);

CREATE TABLE WorkoutItem (
  id TEXT NOT NULL PRIMARY KEY,
  workoutId TEXT NOT NULL REFERENCES Workout(id) ON DELETE CASCADE,
  position INTEGER NOT NULL,
  type TEXT NOT NULL CHECK (type IN ('REGULAR', 'SUPERSET')),
  exerciseId TEXT REFERENCES Exercise(id),
  sets INTEGER NOT NULL DEFAULT 3,
  rounds INTEGER NOT NULL DEFAULT 1,
  reps INTEGER NOT NULL DEFAULT 10,
  restSeconds INTEGER NOT NULL DEFAULT 60,
  notes TEXT
);

CREATE TABLE SupersetMember (
  id TEXT NOT NULL PRIMARY KEY,
  itemId TEXT NOT NULL REFERENCES WorkoutItem(id) ON DELETE CASCADE,
  position INTEGER NOT NULL,
  exerciseId TEXT NOT NULL REFERENCES Exercise(id),
  reps INTEGER NOT NULL
);

CREATE TABLE Settings (
  key TEXT NOT NULL PRIMARY KEY,
  value TEXT NOT NULL
);

CREATE TABLE Session (
  id TEXT NOT NULL PRIMARY KEY,
  workoutId TEXT NOT NULL,
  workoutName TEXT NOT NULL,
  startedAt TEXT NOT NULL,
  durationSeconds INTEGER NOT NULL
);

CREATE TABLE SessionEntry (
  id TEXT NOT NULL PRIMARY KEY,
  sessionId TEXT NOT NULL REFERENCES Session(id) ON DELETE CASCADE,
  position INTEGER NOT NULL,
  exerciseName TEXT NOT NULL,
  itemType TEXT NOT NULL CHECK (itemType IN ('REGULAR', 'SUPERSET')),
  setNumber INTEGER,
  roundNumber INTEGER,
  targetReps INTEGER NOT NULL,
  actualReps INTEGER,
  completed INTEGER NOT NULL DEFAULT 0
);

selectAllWorkouts:
SELECT * FROM Workout ORDER BY position;

selectAllExercises:
SELECT * FROM Exercise ORDER BY name;

selectAllSessions:
SELECT * FROM Session ORDER BY startedAt DESC;

selectWorkoutItems:
SELECT * FROM WorkoutItem WHERE workoutId = ? ORDER BY position;

selectSupersetMembers:
SELECT * FROM SupersetMember WHERE itemId = ? ORDER BY position;

selectAllSessionEntries:
SELECT * FROM SessionEntry ORDER BY position;

selectCompletedEntryCount:
SELECT COUNT(*) FROM SessionEntry WHERE completed = 1;

selectSetting:
SELECT value FROM Settings WHERE key = ?;

upsertExercise:
INSERT OR REPLACE INTO Exercise(id, name, defaultSets, defaultReps, defaultRestSeconds, notes, imagePath)
VALUES (?, ?, ?, ?, ?, ?, ?);

upsertSetting:
INSERT OR REPLACE INTO Settings(key, value) VALUES (?, ?);

deleteExercise:
DELETE FROM Exercise WHERE id = ?;

insertWorkout:
INSERT INTO Workout(id, name, position, createdAt) VALUES (?, ?, ?, ?);

deleteWorkout:
DELETE FROM Workout WHERE id = ?;

updateWorkoutPosition:
UPDATE Workout SET position = ? WHERE id = ?;

deleteSupersetMembersForWorkout:
DELETE FROM SupersetMember WHERE itemId IN (SELECT id FROM WorkoutItem WHERE workoutId = ?);

deleteWorkoutItems:
DELETE FROM WorkoutItem WHERE workoutId = ?;

insertWorkoutItem:
INSERT INTO WorkoutItem(id, workoutId, position, type, exerciseId, sets, rounds, reps, restSeconds, notes)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

insertSupersetMember:
INSERT INTO SupersetMember(id, itemId, position, exerciseId, reps) VALUES (?, ?, ?, ?, ?);

insertSession:
INSERT INTO Session(id, workoutId, workoutName, startedAt, durationSeconds) VALUES (?, ?, ?, ?, ?);

insertSessionEntry:
INSERT INTO SessionEntry(id, sessionId, position, exerciseName, itemType, setNumber, roundNumber, targetReps, actualReps, completed)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);
